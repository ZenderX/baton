{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["core/extensions/**/*.ts", "conductor/extensions/**/*.ts", "refuter/extensions/**/*.ts"]
}
