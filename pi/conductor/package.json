    "skills": [
      "./skills/conductor",
      "./skills/bevy",
      "./skills/blender",
      "./skills/rust",
      "./skills/typescript",
      "./skills/vue3"
    ],
    "prompts": [
      "./prompts"
    ],
    "mcp": "./.mcp.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24",
    "typescript": "^5"
  }
}
