{
  "name": "the-pi-conductor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Conductor orchestrator + subagents and domain skills for pi (canonical pi package)",
  "license": "MIT",
  "author": "ZenderX",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/conductor/index.ts",
      "./extensions/statusline.ts",
      "./extensions/task-list.ts",
      "./extensions/lmstudio-reasoning.ts"
