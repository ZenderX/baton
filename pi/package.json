{
  "name": "pi-baton",
  "version": "5.0.1",
  "private": true,
  "type": "module",
  "description": "Umbrella pi package for baton: loads the baton core engine, the conductor and the refuter from one install, plus the shared context7 MCP server. Also the dev workspace (shared devDependencies, single tsconfig for typecheck).",
  "license": "MIT",
  "author": "ZenderX",
  "pi": {
    "extensions": [
      "./core/extensions/engine/index.ts",
      "./core/extensions/statusline.ts",
      "./core/extensions/task-list.ts",
      "./core/extensions/lmstudio-reasoning.ts",
      "./core/extensions/drift-nudge.ts",
      "./core/extensions/restore-crlf.ts",
      "./conductor/extensions/conductor.ts",
      "./refuter/extensions/refuter.ts"
    ],
    "skills": [
      "../claude/plugins/baton/skills",
      "../claude/plugins/bevy/skills",
      "../claude/plugins/blender/skills",
      "../claude/plugins/rust/skills",
      "../claude/plugins/typescript/skills",
      "../claude/plugins/vue3/skills"
    ],
    "prompts": [
      "./conductor/prompts",
      "./refuter/prompts"
    ],
    "mcp": "./.mcp.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24",
    "typescript": "^5"
  }
}
